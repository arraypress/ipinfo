{
  "name": "arraypress/wp-ipinfo",
  "description": "A PHP library for integrating with the IPInfo.io API in WordPress, providing geolocation, ASN data, privacy detection, and hosting information. Features plan-aware responses and WordPress transient caching.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/arraypress/wp-ipinfo/",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3",
    "arraypress/wp-countries": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\IPInfo\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "stable",
  "support": {
    "issues": "https://github.com/arraypress/wp-ipinfo/issues",
    "source": "https://github.com/arraypress/wp-ipinfo"
  },
  "keywords": [
    "ipinfo",
    "geolocation",
    "ip-lookup",
    "asn",
    "privacy-detection",
    "wordpress",
    "vpn-detection",
    "proxy-detection",
    "hosting-detection",
    "ip-geolocation",
    "ip-information"
  ],
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "ArrayPress\\IPInfo\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  }
}
